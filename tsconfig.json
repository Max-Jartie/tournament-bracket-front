{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",

    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],

    "jsx": "react-jsx",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "noEmit": false,
    "isolatedModules": false,

    "sourceMap": true,

    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}